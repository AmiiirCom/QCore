# ==============================================================
# QCore Official Git Ignore Rules
# ==============================================================

# --- Project Snapshots & Temporary Markdown Dumps ---
md_snapshot.md
*.snapshot.md

# --- Rust & Cargo Build Artifacts ---
target/
**/target/
**/*.rs.bk
*.pdb

# --- Native Executables & Libraries ---
*.exe
*.dll
*.so
*.dylib

# --- WebAssembly & Node.js Build Outputs ---
core/crates/qcore-wasm/pkg/
**/pkg/
worker/dist/
worker/node_modules/
package-lock.json
worker/package-lock.json

# --- Sensitive Runtime Configurations & Private Keys ---
# CRITICAL: Never commit files containing private keys, decapsulation keys, or user tokens!
server_config.json
client_config.json
**/server_config.json
**/client_config.json
*.key
*.pem
*.crt
*.dat
*.pfx

# --- Packaging, Dist, and CI/CD Output Artifacts ---
dist/
artifacts/
**/artifacts/
*.zip
*.tar.gz
*.deb
*.pkg.tar.zst
*.sha256
RELEASE_NOTES.md

# --- Development Environments & Editors (IDEs) ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.fleet/

# --- Operating System Noise Files ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory